# Copy to .env and fill in. Vite only exposes variables prefixed with VITE_.
# These are read at build time (vite build) and baked into the bundle.

# Base URL of the API gateway. REQUIRED.
VITE_API_URL=http://localhost:8080

# Stripe publishable key — enables the card-deposit checkout UI.
# Without it, the Add Money page shows a "requires VITE_STRIPE_PUBLISHABLE_KEY" notice.
# Use the pk_test_... key that matches the backend's STRIPE_SECRET_KEY.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
