{
  "info": {
    "name": "Digital Banking System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "All endpoints through the API gateway, with JWT auth.\n\n1. Auth \u2192 Register, then open the link from the verification email (or the notification-service log).\n2. Auth \u2192 Login (saves the token; every other request sends it automatically).\n3. Admin requests use `{{adminToken}}` \u2014 run 'Login as admin' first (credentials in .env).\n\nOTP for flagged transfers: `docker compose logs notification-service | grep OTP` \u2192 paste into the `otp` variable."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "email",
      "value": "alice@example.com"
    },
    {
      "key": "password",
      "value": "Secret123"
    },
    {
      "key": "adminEmail",
      "value": "admin@elibanking.local"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "verificationToken",
      "value": ""
    },
    {
      "key": "resetToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "senderAccount",
      "value": ""
    },
    {
      "key": "receiverAccount",
      "value": ""
    },
    {
      "key": "transactionId",
      "value": ""
    },
    {
      "key": "otp",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Gateway health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
