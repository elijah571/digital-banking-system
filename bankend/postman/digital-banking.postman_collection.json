    {
      "name": "Transactions",
      "item": [
        {
          "name": "Transfer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Required (wallet-plan 3.6). Send the same key when retrying the same transfer; a new key starts a new transfer."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transactions"
              ]
            },
            "description": "Set `receiverAccount` to another user's account number first.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderAccountNumber\": \"{{senderAccount}}\",\n  \"receiverAccountNumber\": \"{{receiverAccount}}\",\n  \"amount\": 1000,\n  \"type\": \"TRANSFER\",\n  \"description\": \"rent\",\n  \"pin\": \"{{pin}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('transactionId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "External bank transfer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Reuse this key only when retrying this exact payout."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transactions"
              ]
            },
            "description": "Run Resolve withdrawal destination first. A bankCode other than OWN_BANK_CODE routes this request through the shared outbound payout pipeline.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderAccountNumber\": \"{{senderAccount}}\",\n  \"receiverAccountNumber\": \"{{destinationAccount}}\",\n  \"amount\": \"{{withdrawalAmount}}\",\n  \"type\": \"TRANSFER\",\n  \"description\": \"external transfer\",\n  \"pin\": \"{{pin}}\",\n  \"bankCode\": \"{{bankCode}}\",\n  \"nameEnquiryRef\": \"{{nameEnquiryRef}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('accepted', () => pm.response.to.have.status(202));",
                  "pm.collectionVariables.set('payoutId', pm.response.json().payoutId);"
                ]
              }
            }
          ]
        },
