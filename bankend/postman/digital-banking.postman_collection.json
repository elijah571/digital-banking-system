    },
    {
      "key": "password",
      "value": "Secret123"
    },
    {
      "key": "adminEmail",
      "value": "admin@elibanking.local"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "verificationToken",
      "value": ""
    },
    {
      "key": "resetToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "senderAccount",
      "value": ""
    },
    {
      "key": "receiverAccount",
      "value": ""
    },
    {
      "key": "transactionId",
      "value": ""
    },
    {
      "key": "depositId",
      "value": ""
    },
    {
      "key": "otp",
      "value": ""
