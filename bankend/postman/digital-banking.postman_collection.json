{
  "info": {
    "name": "Digital Banking System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "All endpoints through the API gateway, with JWT auth.\n\n1. Auth \u2192 Register, then open the link from the verification email (or the notification-service log).\n2. Auth \u2192 Login (saves the token; every other request sends it automatically).\n3. Admin requests use `{{adminToken}}` \u2014 run 'Login as admin' first (credentials in .env).\n\nOTP for flagged transfers: `docker compose logs notification-service | grep OTP` \u2192 paste into the `otp` variable."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
