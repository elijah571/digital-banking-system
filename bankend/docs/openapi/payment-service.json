{
  "openapi": "3.1.0",
  "info": {
    "title": "Payment Service API",
    "description": "Stripe card payments. Errors are returned as application/problem+json.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current host"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Payments",
      "description": "Card payments through Stripe"
    }
  ],
  "paths": {
    "/api/v1/payments/webhook": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Stripe webhook (called by Stripe, public)",
        "description": "Receives `payment_intent.succeeded` / `payment_intent.payment_failed`, updates the payment and publishes `payment.completed` / `payment.failed`. Not meant to be called manually — the `Stripe-Signature` header is verified with STRIPE_WEBHOOK_SECRET. To test locally: `stripe listen --forward-to localhost:8080/api/v1/payments/webhook`.",
        "operationId": "handleWebhook",
        "parameters": [
          {
            "name": "Stripe-Signature",
            "in": "header",
            "description": "Signature header set by Stripe",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Event processed",
            "content": {
              "*/*": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid Stripe signature",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/v1/payments/create-order": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Create a Stripe payment order",
        "description": "Creates a Stripe PaymentIntent in USD for one of **your own** accounts. Use the returned `clientSecret` and `stripePublishableKey` with Stripe.js / Stripe Elements on the frontend to collect the card. The final result arrives through the webhook. Amount must have at most 2 decimals.",
        "operationId": "createPaymentOrder",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Payment intent created, status CREATED",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentOrderResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed, or amount has more than 2 decimals",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Account belongs to another user",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Account not found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "502": {
            "description": "Stripe rejected the request or is unreachable",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProblemDetail": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {}
          }
        }
      },
      "CreatePaymentRequest": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "description": "Amount in USD, max 2 decimals",
            "example": 25.5,
            "minimum": 0
          },
          "accountNumber": {
            "type": "string",
            "example": "3693612260",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "example": "Account top-up"
          }
        },
        "required": [
          "accountNumber",
          "amount"
        ]
      },
      "PaymentOrderResponse": {
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "string"
          },
          "stripePaymentIntentId": {
            "type": "string"
          },
          "clientSecret": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "stripePublishableKey": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
