{
  "openapi": "3.1.0",
  "info": {
    "title": "Transaction Service API",
    "description": "Money transfers with asynchronous fraud check and OTP verification. Errors are returned as application/problem+json.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current host"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Transactions",
      "description": "Money transfers (saga with fraud check) and OTP verification"
    }
  ],
  "paths": {
    "/api/v1/transactions": {
      "get": {
        "tags": [
          "Transactions"
        ],
        "summary": "List all transactions (ADMIN)",
        "description": "Every transaction, newest first.",
        "operationId": "getAllTransactions",
        "responses": {
          "200": {
            "description": "All transactions",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransactionResponse"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Not an admin",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransactionResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Transactions"
        ],
        "summary": "Transfer money",
        "description": "Sends money **from one of your own accounts**. Debits the sender immediately and returns the transaction with status **PROCESSING**.\nThe fraud-detection service then checks it asynchronously (usually < 1 s):\n\n* **clean** → status becomes **COMPLETED** and the receiver is credited\n* **suspicious** (> 5 transfers/min, amount > 5× the account's average, or > 90 % of balance)\n  → status becomes **PENDING_VERIFICATION** and an OTP is sent (valid 5 minutes).\n  Confirm with `POST /api/v1/transactions/{id}/verify`.\n\nPoll `GET /api/v1/transactions/{id}` to follow the status.",
        "operationId": "transfer",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransactionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Transfer accepted, status PROCESSING",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (missing account numbers, non-positive amount, missing type)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Sender account is not yours",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Sender account not found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "422": {
            "description": "Insufficient funds, or sender account not active",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "502": {
            "description": "Account service unavailable",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/transactions/{transactionId}/verify": {
      "post": {
        "tags": [
          "Transactions"
        ],
        "summary": "Verify OTP for a flagged transfer",
        "description": "Only for transactions in **PENDING_VERIFICATION**.\n\n* correct OTP → **COMPLETED**, receiver credited\n* wrong OTP → **FLAGGED**, sender refunded and sender account **BLOCKED**\n* OTP expired (5 min) → **FLAGGED**, sender refunded\n\nThe OTP is delivered by notification-service (currently written to its log).",
        "operationId": "verifyOTP",
        "parameters": [
          {
            "name": "transactionId",
            "in": "path",
            "description": "Transaction id (UUID)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "otp",
            "in": "query",
            "description": "6-digit OTP",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": 403826
          }
        ],
        "responses": {
          "200": {
            "description": "Verification processed — check `status` in the body",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionResponse"
                }
              }
            }
          },
          "404": {
            "description": "Transaction not found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Only the sender can verify",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "Transaction is not awaiting OTP verification (e.g. already verified)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/transactions/{transactionId}": {
      "get": {
        "tags": [
          "Transactions"
        ],
        "summary": "Get a transaction",
        "description": "Status is one of PROCESSING, PENDING_VERIFICATION, COMPLETED, FLAGGED.",
        "operationId": "getTransaction",
        "parameters": [
          {
            "name": "transactionId",
            "in": "path",
            "description": "Transaction id (UUID)",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "3698340e-3947-4615-a4fd-fd903a1a436e"
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionResponse"
                }
              }
            }
          },
          "403": {
            "description": "Transaction belongs to another user",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Transaction not found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/transactions/account/{accountNumber}": {
      "get": {
        "tags": [
          "Transactions"
        ],
        "summary": "Transaction history of an account",
        "description": "Transfers **sent** by this account, newest first. Empty list if there are none.",
        "operationId": "getTransactionHistory",
        "parameters": [
          {
            "name": "accountNumber",
            "in": "path",
            "description": "10-digit account number",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": 3693612260
          }
        ],
        "responses": {
          "200": {
            "description": "List of transactions (may be empty)",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransactionResponse"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Account belongs to another user",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TransactionRequest": {
        "type": "object",
        "properties": {
          "senderAccountNumber": {
            "type": "string",
            "example": "3693612260",
            "minLength": 1
          },
          "receiverAccountNumber": {
            "type": "string",
            "example": "3583221418",
            "minLength": 1
          },
          "amount": {
            "type": "number",
            "example": 1000,
            "minimum": 0
          },
          "description": {
            "type": "string",
            "example": "Rent for November"
          },
          "type": {
            "type": "string",
            "enum": [
              "DEPOSIT",
              "WITHDRAWAL",
              "PAYMENT",
              "TRANSFER"
            ],
            "example": "TRANSFER"
          }
        },
        "required": [
          "amount",
          "receiverAccountNumber",
          "senderAccountNumber",
          "type"
        ]
      },
      "ProblemDetail": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {}
          }
        }
      },
      "TransactionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "senderAccountNumber": {
            "type": "string"
          },
          "receiverAccountNumber": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "failureReason": {
            "type": "string"
          },
          "referenceNumber": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "DEPOSIT",
              "WITHDRAWAL",
              "PAYMENT",
              "TRANSFER"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PROCESSING",
              "PENDING",
              "COMPLETED",
              "PENDING_VERIFICATION",
              "FLAGGED",
              "FAILED"
            ]
          },
          "amount": {
            "type": "number"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
