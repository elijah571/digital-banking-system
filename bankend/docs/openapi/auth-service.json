{"openapi":"3.1.0","info":{"title":"Auth Service API","description":"Registration, email verification, login with JWT, password reset and user management. Log in, copy `accessToken`, click **Authorize** and paste it.","version":"v1"},"servers":[{"url":"/","description":"Current host"}],"security":[{"bearerAuth":[]}],"tags":[{"name":"Authentication","description":"Register, verify email, login, refresh, logout, password reset"},{"name":"User management (ADMIN)","description":"List users, change roles, enable/disable accounts"}],"paths":{"/api/v1/auth/reset-password":{"post":{"tags":["Authentication"],"summary":"Set a new password with the emailed token","description":"Also logs the user out everywhere (all refresh tokens are revoked).","operationId":"resetPassword","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResetPasswordRequest"}}},"required":true},"responses":{"200":{"description":"Password changed","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MessageResponse"}}}},"400":{"description":"Token invalid/expired, or weak password","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}},"security":[]}},"/api/v1/auth/resend-verification":{"post":{"tags":["Authentication"],"summary":"Resend the verification email","description":"Always returns 200 with the same message, so it cannot be used to discover registered emails.","operationId":"resendVerification","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/EmailRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MessageResponse"}}}}},"security":[]}},"/api/v1/auth/register":{"post":{"tags":["Authentication"],"summary":"Register a new user","description":"Creates a USER account and emails a verification link (valid 24 h). Login is refused until the email is verified.","operationId":"register","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegisterRequest"}}},"required":true},"responses":{"201":{"description":"Registered — check your inbox","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"400":{"description":"Validation failed (weak password, invalid email…)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"409":{"description":"Email already registered","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}},"security":[]}},"/api/v1/auth/refresh":{"post":{"tags":["Authentication"],"summary":"Get a new access token","description":"Exchanges a refresh token for a new access + refresh token pair. Each refresh token works once.","operationId":"refresh","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RefreshRequest"}}},"required":true},"responses":{"200":{"description":"New tokens","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TokenResponse"}}}},"401":{"description":"Refresh token invalid, expired or already used","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}},"security":[]}},"/api/v1/auth/logout":{"post":{"tags":["Authentication"],"summary":"Log out","description":"Revokes the refresh token. The access token simply expires (15 min).","operationId":"logout","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RefreshRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MessageResponse"}}}}},"security":[]}},"/api/v1/auth/login":{"post":{"tags":["Authentication"],"summary":"Log in","description":"Returns a JWT access token (send it as `Authorization: Bearer <token>`) and a refresh token.","operationId":"login","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginRequest"}}},"required":true},"responses":{"200":{"description":"Logged in","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TokenResponse"}}}},"401":{"description":"Wrong email or password","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"403":{"description":"Email not verified, or account disabled","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}},"security":[]}},"/api/v1/auth/forgot-password":{"post":{"tags":["Authentication"],"summary":"Request a password reset email","description":"Emails a reset token (valid 30 min). Always returns 200 with the same message.","operationId":"forgotPassword","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/EmailRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MessageResponse"}}}}},"security":[]}},"/api/v1/auth/change-password":{"post":{"tags":["Authentication"],"summary":"Change password (logged in)","description":"Requires the current password. Logs out all other sessions.","operationId":"changePassword","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangePasswordRequest"}}},"required":true},"responses":{"200":{"description":"Password changed","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MessageResponse"}}}},"400":{"description":"Current password wrong, or new password too weak","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}}},"/api/v1/users/{id}":{"get":{"tags":["User management (ADMIN)"],"summary":"Get a user","operationId":"get","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"User","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"404":{"description":"Not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}},"patch":{"tags":["User management (ADMIN)"],"summary":"Change a user's role and/or enable/disable them","description":"Disabling a user logs them out (refresh tokens revoked) and blocks future logins. An admin cannot demote or disable themselves.","operationId":"update","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateUserRequest"}}},"required":true},"responses":{"200":{"description":"Updated user","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"404":{"description":"Not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"409":{"description":"Admin tried to demote/disable themselves","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}}},"/api/v1/users":{"get":{"tags":["User management (ADMIN)"],"summary":"List all users (newest first)","operationId":"list","responses":{"200":{"description":"Users","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/UserResponse"}}}}},"403":{"description":"Not an admin","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/UserResponse"}}}}}}}},"/api/v1/auth/verify-email":{"get":{"tags":["Authentication"],"summary":"Verify email (link from the verification email)","description":"Opened in the browser from the email. Returns a small HTML page.","operationId":"verifyEmail","parameters":[{"name":"token","in":"query","description":"Token from the email link","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Email verified","content":{"text/html":{"schema":{"type":"string"}}}},"400":{"description":"Link invalid, already used or expired","content":{"text/html":{"schema":{"type":"string"}}}}},"security":[]}},"/api/v1/auth/me":{"get":{"tags":["Authentication"],"summary":"Current user profile","operationId":"me","responses":{"200":{"description":"The logged-in user","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"401":{"description":"Missing or invalid access token","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}}}}}},"components":{"schemas":{"VerifyPasswordRequest":{"type":"object","properties":{"userId":{"type":"string","minLength":1},"password":{"type":"string","minLength":1}},"required":["password","userId"]},"VerifyPasswordResponse":{"type":"object","properties":{"valid":{"type":"boolean"}}},"ResetPasswordRequest":{"type":"object","properties":{"token":{"type":"string","description":"Token from the password-reset email","minLength":1},"newPassword":{"type":"string","example":"NewSecret456","maxLength":72,"minLength":8,"pattern":"^(?=.*[A-Za-z])(?=.*\\d).+$"}},"required":["newPassword","token"]},"ProblemDetail":{"type":"object","properties":{"type":{"type":"string","format":"uri"},"title":{"type":"string"},"status":{"type":"integer","format":"int32"},"detail":{"type":"string"},"instance":{"type":"string","format":"uri"},"properties":{"type":"object","additionalProperties":{}}}},"MessageResponse":{"type":"object","properties":{"message":{"type":"string"}}},"EmailRequest":{"type":"object","properties":{"email":{"type":"string","format":"email","example":"alice@example.com","minLength":1}},"required":["email"]},"RegisterRequest":{"type":"object","properties":{"fullName":{"type":"string","example":"Alice Johnson","maxLength":100,"minLength":0},"email":{"type":"string","format":"email","example":"alice@example.com","minLength":1},"password":{"type":"string","description":"8-72 characters, at least one letter and one digit","example":"Secret123","maxLength":72,"minLength":8,"pattern":"^(?=.*[A-Za-z])(?=.*\\d).+$"}},"required":["email","fullName","password"]},"UserResponse":{"type":"object","properties":{"id":{"type":"string"},"fullName":{"type":"string"},"email":{"type":"string"},"role":{"type":"string","enum":["USER","ADMIN"]},"emailVerified":{"type":"boolean"},"enabled":{"type":"boolean"},"createdAt":{"type":"string","format":"date-time"}}},"RefreshRequest":{"type":"object","properties":{"refreshToken":{"type":"string","minLength":1}},"required":["refreshToken"]},"TokenResponse":{"type":"object","properties":{"accessToken":{"type":"string","description":"JWT — send as `Authorization: Bearer <token>`"},"refreshToken":{"type":"string","description":"Opaque token for POST /api/v1/auth/refresh (single use, rotated on every refresh)"},"tokenType":{"type":"string"},"expiresIn":{"type":"integer","format":"int64","description":"Access token lifetime in seconds"},"user":{"$ref":"#/components/schemas/UserResponse"}}},"LoginRequest":{"type":"object","properties":{"email":{"type":"string","example":"alice@example.com","minLength":1},"password":{"type":"string","example":"Secret123","minLength":1}},"required":["email","password"]},"ChangePasswordRequest":{"type":"object","properties":{"currentPassword":{"type":"string","example":"Secret123","minLength":1},"newPassword":{"type":"string","example":"NewSecret456","maxLength":72,"minLength":8,"pattern":"^(?=.*[A-Za-z])(?=.*\\d).+$"}},"required":["currentPassword","newPassword"]},"UpdateUserRequest":{"type":"object","properties":{"role":{"type":"string","description":"USER or ADMIN","enum":["USER","ADMIN"],"example":"ADMIN"},"enabled":{"type":"boolean","description":"false = user can no longer log in","example":true}}},"Entry":{"type":"object","properties":{"id":{"type":"integer","format":"int64"},"occurredAt":{"type":"string","format":"date-time"},"actor":{"type":"string"},"action":{"type":"string"},"entityType":{"type":"string"},"entityId":{"type":"string"},"correlationId":{"type":"string"},"details":{"type":"string"},"source":{"type":"string"}}}},"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","bearerFormat":"JWT"}}}}