# Copy to .env and fill in. .env is gitignored — never commit real keys.
MYSQL_ROOT_PASSWORD=change-me
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=3000
DB_POOL_VALIDATION_TIMEOUT_MS=1000
DB_POOL_MAX_LIFETIME_MS=1740000
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional: host port for Docker Redis if 6379 is already in use
# REDIS_HOST_PORT=6380

# ---- Authentication ----
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
# Service tokens for account-service (HS256). Different from JWT_SECRET. Generate with: openssl rand -base64 48
INTERNAL_JWT_SECRET=change-me-to-a-different-long-random-string-at-least-32-bytes
FIREBLOCKS_ENABLED=false
FIREBLOCKS_BASE_URL=https://sandbox-api.fireblocks.io
FIREBLOCKS_API_KEY=
FIREBLOCKS_PRIVATE_KEY=
FIREBLOCKS_WEBHOOK_WORKSPACE_ID=
FIREBLOCKS_WEBHOOK_JWKS_URL=https://sandbox-keys.fireblocks.io/.well-known/jwks.json
# HMAC key for the hash of a transfer OTP (transaction-service only). At least 32 bytes, and not the same as the two above. Generate with: openssl rand -base64 48
OTP_HMAC_KEY=change-me-to-another-long-random-string-at-least-32-bytes
# First admin account, created on auth-service's first start
ADMIN_EMAIL=elijahfx43@gmail.com
ADMIN_PASSWORD=Adm1n-1234567890Pe*
# ---- Local bank and outbound transfer settings (required by Compose) ----
# Replace these sample values with the bank identifier configured for your environment.
OWN_BANK_CODE=ELIPAY
OWN_BANK_NAME=ELI-PAY
WITHDRAWAL_MIN=1000.00
WITHDRAWAL_MAX=1000000.00
WITHDRAWAL_DAILY_MAX=2000000.00
WITHDRAWAL_APPROVAL_THRESHOLD=100000.00
OUTBOUND_FEE=0.00
PAYOUT_PROVIDER=simulator
PAYOUT_SIM_DEFAULT_OUTCOME=success
PAYOUT_SIM_DELAY_MS=0

# Required wallet PIN protection keys. Generate distinct random values (at least 32 bytes).
PIN_PEPPER=replace-with-a-distinct-random-secret-of-at-least-32-bytes
PIN_OTP_HMAC_KEY=replace-with-another-distinct-random-secret-of-at-least-32-bytes

# Optional local service configuration.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
APP_PUBLIC_URL=http://localhost:8080
PASSWORD_RESET_URL=http://localhost:5173/reset-password
MAIL_FROM=ELI-PAY <no-reply@example.com>
MAIL_LOG_CONTENT=true
ACCOUNT_VERIFIED_DAILY_LIMIT=5000000.00
# Optional port overrides if the local defaults are already in use.
# GATEWAY_PORT=8080
# REDIS_HOST_PORT=6379


# ---- Email (Gmail SMTP) ----
# SMTP_PASSWORD must be a Google App Password (Google Account > Security > 2-Step Verification > App passwords).
# Port 465 = SSL, 587 = STARTTLS. Leave SMTP_MAIL / SMTP_PASSWORD empty to log emails instead of sending them.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_MAIL=you@gmail.com
SMTP_PASSWORD=abcdefghijklmnop
# Public URL of the gateway, used in the verification link (e.g. https://api.yourbank.com)
# APP_PUBLIC_URL=http://localhost:8080
# Frontend page where users choose a new password (?token=... is appended)
# PASSWORD_RESET_URL=http://localhost:3000/reset-password
