# Copy to .env and fill in. .env is gitignored — never commit real keys.
MYSQL_ROOT_PASSWORD=change-me
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional: host port for Docker Redis if 6379 is already in use
# REDIS_HOST_PORT=6380

# ---- Authentication ----
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ---- Email (Gmail SMTP) ----
# SMTP_PASSWORD must be a Google App Password (Google Account > Security > 2-Step Verification > App passwords).
# Port 465 = SSL, 587 = STARTTLS. Leave SMTP_MAIL / SMTP_PASSWORD empty to log emails instead of sending them.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_MAIL=you@gmail.com
SMTP_PASSWORD=abcdefghijklmnop
# Public URL of the gateway, used in the verification link (e.g. https://api.yourbank.com)
# APP_PUBLIC_URL=http://localhost:8080
# Frontend page where users choose a new password (?token=... is appended)
# PASSWORD_RESET_URL=http://localhost:3000/reset-password
