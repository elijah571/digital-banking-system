# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Every variable here is consumed by compose.yaml and passed into the services.
# Values marked REQUIRED have no default: Compose refuses to start without them.

# =============================================================================
# Core infrastructure
# =============================================================================
# Dev default is "root". REQUIRED (no default) when using compose.prod.yaml.
MYSQL_ROOT_PASSWORD=change-me

# --- Infrastructure connection overrides (compose.prod.yaml only) ------------
# compose.yaml (dev) always talks to the bundled mysql / redis / kafka containers.
# compose.prod.yaml reads the variables below so .env can point the services at
# either those bundled containers (the defaults shown) or external managed cloud
# instances. Leave them unset/commented to keep using the bundled containers.

# MySQL. With the bundled container the services connect as root using
# MYSQL_ROOT_PASSWORD above; set MYSQL_USER / MYSQL_PASSWORD for an external DB.
# MYSQL_HOST=mysql
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=change-me

# Redis password. REQUIRED by compose.prod.yaml — prod Redis rejects
# unauthenticated clients. Leave unset in dev (the dev Redis has no password).
# Generate with: openssl rand -base64 32
# REDIS_PASSWORD=change-me-to-a-strong-random-string
# REDIS_HOST=redis
# REDIS_PORT=6379
# Set true for a managed Redis that terminates TLS (common for cloud Redis).
# REDIS_SSL_ENABLED=false

# Kafka brokers the services connect to (internal listener on the Compose network).
# KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Host port for Docker Redis, only if 6379 is already taken.
# REDIS_HOST_PORT=6379
# Host port the API gateway is published on (prod override).
# GATEWAY_PORT=8080

# Connection-pool sizing (shared by most services).
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=3000
DB_POOL_VALIDATION_TIMEOUT_MS=1000
DB_POOL_MAX_LIFETIME_MS=1740000
# wallet-service pool — concurrent payouts serialize on the daily-usage row,
# so it runs a larger pool and a longer acquisition timeout than the others.
WALLET_DB_POOL_MAX_SIZE=50
WALLET_DB_POOL_CONNECTION_TIMEOUT_MS=15000

# =============================================================================
# Security secrets — REQUIRED. Each must be distinct and >= 32 bytes.
# Generate with: openssl rand -base64 48
# =============================================================================
# User-facing JWT (HS256).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
# Service-to-service JWT (HS256). Must differ from JWT_SECRET.
INTERNAL_JWT_SECRET=change-me-to-a-different-long-random-string-at-least-32-bytes
# HMAC key for the hash of a transfer OTP (transaction-service).
OTP_HMAC_KEY=change-me-to-another-long-random-string-at-least-32-bytes
# Wallet PIN protection keys (wallet-service).
PIN_PEPPER=replace-with-a-distinct-random-secret-of-at-least-32-bytes
PIN_OTP_HMAC_KEY=replace-with-another-distinct-random-secret-of-at-least-32-bytes

# =============================================================================
# First admin account — created on auth-service's first start (optional).
# =============================================================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Change-Me-1234567890*
# Where operational alert emails go. Defaults to ADMIN_EMAIL when empty.
# OPS_ALERT_EMAIL=

# =============================================================================
# Local bank identity + withdrawal rules — REQUIRED.
# Replace with the bank identifier configured for your environment.
# =============================================================================
OWN_BANK_CODE=ELIPAY
OWN_BANK_NAME=ELI-PAY
WITHDRAWAL_MIN=1000.00
WITHDRAWAL_MAX=1000000.00
WITHDRAWAL_DAILY_MAX=2000000.00
WITHDRAWAL_APPROVAL_THRESHOLD=100000.00
OUTBOUND_FEE=0.00
ACCOUNT_VERIFIED_DAILY_LIMIT=5000000.00

# =============================================================================
# Public URLs / CORS
# =============================================================================
# Gateway URL used in verification links.
APP_PUBLIC_URL=http://localhost:8080
# Frontend page where users choose a new password (?token=... is appended).
PASSWORD_RESET_URL=http://localhost:5173/reset-password
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# Payout provider — choose one via PAYOUT_PROVIDER.
#   simulator   -> no external calls (uses PAYOUT_SIM_* below)
#   flutterwave -> fill the FLUTTERWAVE_* block
#   monnify     -> fill the MONNIFY_* block
# =============================================================================
PAYOUT_PROVIDER=simulator
# Simulator tuning (only used when PAYOUT_PROVIDER=simulator).
PAYOUT_SIM_DEFAULT_OUTCOME=success
PAYOUT_SIM_DELAY_MS=0

# Flutterwave (only used when PAYOUT_PROVIDER=flutterwave).
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# Monnify (only used when PAYOUT_PROVIDER=monnify).
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_SOURCE_ACCOUNT_NUMBER=
MONNIFY_WEBHOOK_SECRET=

# =============================================================================
# Card deposits (Stripe) — payment-service
# =============================================================================
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# =============================================================================
# Email (Gmail SMTP) — notification-service
# SMTP_PASSWORD must be a Google App Password (Account > Security > App passwords).
# Port 465 = SSL, 587 = STARTTLS.
# Leave SMTP_MAIL / SMTP_PASSWORD empty to LOG emails instead of sending them.
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_MAIL=
SMTP_PASSWORD=
# One mailbox, or "Display Name <mailbox>"; use an address verified by the provider.
MAIL_FROM=ELI-PAY <no-reply@example.com>
# Keep true in dev to log verification links/reset tokens; set false in prod.
MAIL_LOG_CONTENT=true

# =============================================================================
# Crypto wallets (Privy) — crypto-service
# When PRIVY_ENABLED=true, the two AUTHORIZATION_* values become mandatory
# (the service fails closed on startup without them).
# =============================================================================
PRIVY_ENABLED=false
PRIVY_BASE_URL=https://api.privy.io/v1
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY_QUORUM_ID=
PRIVY_AUTHORIZATION_PRIVATE_KEY=
PRIVY_WEBHOOK_SIGNING_SECRET=
PRIVY_EVM_CHAIN_IDS=ETHEREUM=1,ETH=1,ERC20=1
